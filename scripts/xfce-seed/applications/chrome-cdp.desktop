[Desktop Entry]
Version=1.0
Type=Application
Name=Chrome CDP
Name[zh_CN]=Chrome CDP
Comment=Google Chrome (CDP profile, port 9222)
Comment[zh_CN]=Google Chrome（CDP 同一 profile，9222）
Exec=/home/apm/.local/bin/chrome-cdp %U
Icon=google-chrome
Terminal=false
StartupNotify=true
Categories=Network;WebBrowser;
