#!/bin/bash
# Dock launcher: single Chrome window. First open starts Chrome+CDP and attaches
# playwright; later clicks toggle via single-instance. Closing Chrome drops CDP
# until the next dock launch (no background monitor).
#
# Rapid dock clicks race the slow cold-start (window/CDP not ready yet). Serialize
# with flock; if a profile Chrome is already starting/running, wait and toggle —
# never clear SingletonLock or spawn another instance.
set -euo pipefail

export HOME="${HOME:-/home/sandbox}"
export PATH="$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:1}"

# shellcheck source=/dev/null
. "$HOME/.local/bin/chrome-cdp-runtime.sh"

LOCK_FILE="${HOME}/.config/chrome-cdp.launch.lock"
mkdir -p "$HOME/.config"

chrome_window_open() {
    wmctrl -lx 2>/dev/null | awk '
        BEGIN { IGNORECASE = 1 }
        /\.Google-chrome-cdp[[:space:]]/ { found = 1; exit }
        END { exit !found }
    '
}

# Any process using this profile (main or zygote) means an instance exists.
chrome_profile_running() {
    pgrep -f "user-data-dir=${CHROME_CDP_DIR}" >/dev/null 2>&1
}

toggle_chrome_window() {
    exec "$HOME/.local/bin/single-instance" \
        --class Google-chrome-cdp \
        -- "$HOME/.local/bin/chrome-cdp" "$@"
}

# Wait for WM window and/or CDP after another launch is in progress.
wait_for_existing_chrome() {
    local i=0
    while [ "$i" -lt 60 ]; do
        if chrome_window_open; then
            return 0
        fi
        if cdp_ready && chrome_window_open; then
            return 0
        fi
        # Still starting: keep waiting while profile processes exist or CDP is up.
        if chrome_profile_running || cdp_ready; then
            i=$((i + 1))
            sleep 0.25
            continue
        fi
        return 1
    done
    chrome_window_open
}

# Exclusive lock for the whole launch decision (including cold start + CDP wait).
exec 9>"$LOCK_FILE"
if ! flock -w 90 9; then
    echo "launch-chrome-cdp: could not acquire launch lock" >&2
    exit 1
fi

# Already mapped: focus / minimize only.
if chrome_window_open; then
    toggle_chrome_window "$@"
fi

# Profile Chrome already running / CDP up (slow first start, or lost the race):
# wait for the window and toggle — do not clear locks or start another.
if chrome_profile_running || cdp_ready; then
    if wait_for_existing_chrome; then
        toggle_chrome_window "$@"
    fi
    echo "launch-chrome-cdp: Chrome profile already active; not starting another" >&2
    exit 0
fi

# Cold start: prepare profile, start Chrome (CDP flags in chrome-cdp), attach.
prepare_chrome_profile
clear_stale_chrome_cdp
mkdir -p /opt/log/chrome-cdp
nohup "$HOME/.local/bin/chrome-cdp" \
    --no-first-run --no-default-browser-check ${1+"$@"} \
    >>/opt/log/chrome-cdp/chrome-cdp.log 2>&1 &
echo $! >"$HOME/.config/chrome-cdp.pid"

i=0
while [ "$i" -lt 30 ]; do
    cdp_ready && break
    i=$((i + 1))
    sleep 1
done

if cdp_ready; then
    attach_playwright_cdp || true
else
    echo "Chrome CDP did not come up on 127.0.0.1:9222" >&2
    exit 1
fi
