#!/bin/sh
# Window size must match VNC geometry so CDP viewport equals SANDBOX_DISPLAY_*.
# --class pins WM_CLASS class to Google-chrome-cdp so panel single-instance can
# match entrypoint and dock launches without relying on the default
# "Google-chrome" class (instance still embeds user-data-dir and has spaces).
W="${SANDBOX_DISPLAY_WIDTH:-1920}"
H="${SANDBOX_DISPLAY_HEIGHT:-1080}"
exec /usr/bin/google-chrome-stable \
  --disable-dev-shm-usage \
  --user-data-dir=/data/google-chrome \
  --disk-cache-dir=/data/chrome-cache \
  --remote-debugging-port=9222 \
  --remote-debugging-address=127.0.0.1 \
  --remote-allow-origins=* \
  --window-position=0,0 \
  --window-size="${W},${H}" \
  --class=Google-chrome-cdp \
  "$@"
